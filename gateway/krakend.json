{
  "version": 3,
  "port": 8000,
  "extra_config": {
    "auth/validator": {
      "alg": "HS256",
      "jwk_url": "", 
      "secret_key": "innovatech_secret_key_2024"
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/login",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/auth/login",
          "method": "POST",
          "host": ["http://localhost:8080"]
        }
      ]
    },
    {
      "endpoint": "/v1/profile/{id}",
      "method": "PUT",
      "backend": [
        {
          "url_pattern": "/api/auth/profile/{id}",
          "method": "PUT",
          "host": ["http://localhost:8080"]
        }
      ],
      "extra_config": {
        "auth/validator": {
          "operation_debug": true
        }
      }
    }
  ]
}